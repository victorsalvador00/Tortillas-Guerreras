<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- CA1062/CA1848/CA1716 generan ruido en Minimal APIs y handlers; el resto se trata como error. -->
    <NoWarn>$(NoWarn);CA1062;CA1848;CA1716;CA1515;CA1711;CA1724;CA1031;CA2227;CA1002;CA1819;CA1308;CA1305;CA1304;CA1311;CA1310;CA1307;CA1309;CA1822;CA1859;CA1861;CA1860;CA2201;CA1720;CA1707;CA1805;CA1852;CA1812;CA1056;CA1054;CA1055;CA1034;CA1032;CA1064;CA1051;CA2208;CA1806;CA1863;CA1001;CA2000;CA1823;CA1050;CA1000;CA2225;CA1040;CA1825;CA1869;CA2263;CA1866;CA1865;CA1847;CA1310;CA1862;CA1851;CA2016;CA1826;CA1829;CA1873;CA1725</NoWarn>
  </PropertyGroup>
</Project>
