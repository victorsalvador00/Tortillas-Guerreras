<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <RootNamespace>TG.Modules.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\TG.SharedKernel\TG.SharedKernel.csproj" />
    <ProjectReference Include="..\..\src\Modules\TG.Seguridad\TG.Seguridad.csproj" />
    <ProjectReference Include="..\..\src\Modules\TG.Catalogos\TG.Catalogos.csproj" />
    <ProjectReference Include="..\..\src\Modules\TG.Compras\TG.Compras.csproj" />
    <ProjectReference Include="..\..\src\Modules\TG.Produccion\TG.Produccion.csproj" />
    <ProjectReference Include="..\..\src\Modules\TG.Inventario\TG.Inventario.csproj" />
    <ProjectReference Include="..\..\src\Modules\TG.Logistica\TG.Logistica.csproj" />
    <ProjectReference Include="..\..\src\Modules\TG.Ventas\TG.Ventas.csproj" />
    <ProjectReference Include="..\..\src\Modules\TG.Facturacion\TG.Facturacion.csproj" />
    <ProjectReference Include="..\..\src\Modules\TG.Sincronizacion\TG.Sincronizacion.csproj" />
  </ItemGroup>
</Project>
