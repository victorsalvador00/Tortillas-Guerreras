# Subdominios del cliente [SUP-18]: api., app. y factura. con HTTPS automático.
{
	email {$CORREO_ACME}
}

api.{$DOMINIO} {
	encode zstd gzip
	reverse_proxy api:8080
}

app.{$DOMINIO} {
	encode zstd gzip
	root * /srv/web
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}

factura.{$DOMINIO} {
	encode zstd gzip
	root * /srv/portal
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}
